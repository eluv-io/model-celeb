# Build context is the repo root (the shared `celeb` package and setup.py live there).
#
# Build from the repo root with:
#   `make -f Makefile.tagger build`
# or `podman build -f model-celeb-vector-tagger/Containerfile -t celeb-vector-tagger .`
FROM continuumio/miniconda3:latest
WORKDIR /elv

RUN conda create -n mlpod python=3.10 -y

# libgl1/libglib2.0-0: opencv (pulled in by common-ml) needs them to import
RUN apt-get update && apt-get install -y build-essential git libgl1 libglib2.0-0

# install dependencies only; the code is copied in below so code changes don't reinstall them
COPY setup.py .
RUN mkdir -p src/vector src/tagger
RUN /opt/conda/envs/mlpod/bin/pip install ".[tagger]"

# ground truth pools only (IBC etc.), no detection/embedding weights needed
COPY models/image_features ./models/image_features

COPY src/__init__.py src/config.py ./src/
COPY src/tagger ./src/tagger
COPY model-celeb-vector-tagger/config.yml model-celeb-vector-tagger/run.py ./

# the pool search is one BLAS matmul per chunk: past ~8 threads it burns far more CPU for no speedup
ENV OPENBLAS_NUM_THREADS=8 OMP_NUM_THREADS=8 MKL_NUM_THREADS=8

ENTRYPOINT ["/opt/conda/envs/mlpod/bin/python", "run.py"]
